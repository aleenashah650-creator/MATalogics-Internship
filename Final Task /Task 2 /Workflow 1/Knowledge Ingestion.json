    {
      "parameters": {
        "jsCode": "const text = $input.first().json.data;\n\nconst paragraphs = text\n  .split(/\\n\\s*\\n/)\n  .map(p => p.trim())\n  .filter(Boolean);\n\nconst maxLength = 1200;\nconst chunks = [];\n\nlet current = \"\";\n\nfor (const paragraph of paragraphs) {\n  if (current && (current.length + paragraph.length + 2) > maxLength) {\n    chunks.push({\n      json: {\n        text: current,\n        source: \"UrbanCart Product Catalog\",\n        document_type: \"product_catalog\"\n      }\n    });\n\n    current = paragraph;\n  } else {\n    current += (current ? \"\\n\\n\" : \"\") + paragraph;\n  }\n}\n\nif (current) {\n  chunks.push({\n    json: {\n      text: current,\n      source: \"UrbanCart Product Catalog\",\n      document_type: \"product_catalog\"\n    }\n  });\n}\n\nreturn chunks;"
      },
