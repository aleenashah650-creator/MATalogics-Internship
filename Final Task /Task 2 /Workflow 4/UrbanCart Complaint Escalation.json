      "parameters": {
        "jsCode": "const output = $json.output || '';\n\nconst lower = output.toLowerCase();\n\nconst escalationKeywords = [\n  'human',\n  'escalat',\n  'damaged',\n  'defective',\n  'refund',\n  'angry',\n  'dissatisfied',\n  'serious delivery'\n];\n\nconst requiresHuman = escalationKeywords.some(keyword =>\n  lower.includes(keyword)\n);\n\nreturn [\n  {\n    json: {\n      ai_response: output,\n      requires_human: requiresHuman\n    }\n  }\n];"
      },
